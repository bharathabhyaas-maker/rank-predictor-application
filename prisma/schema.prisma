
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  password    String
  role        UserRole @default(STUDENT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastLoginAt DateTime?
  
  institution Institution? @relation(fields: [institutionId], references: [id])
  institutionId String?
  
  // User can create predictions
  predictions Prediction[]
  
  @@map("users")
}

// Institution model for managing educational institutions
model Institution {
  id             String   @id @default(cuid())
  institutionId  String   @unique
  name           String
  email          String   @unique
  location       String
  plan           Plan     @default(STANDARD)
  status         Status   @default(ACTIVE)
  contactPerson  String?
  phone          String?
  password       String
  currentStudents Int     @default(0)
  notificationPreferences Json? // Store notification preferences as JSON
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  users User[]
  assignedTemplates InstitutionTemplate[]
  predictions Prediction[]
  teamMembers TeamMember[]
  
  @@map("institutions")
}

// Template model for exam templates
model Template {
  id          String   @id @default(cuid())
  name        String
  examCode    String   @unique
  description String?
  type        String   @default("ai") // "ai", "conditional", etc.
  promptTemplate String? // For AI-based templates
  placeholders Json?    // For AI-based templates
  status      Status   @default(ACTIVE)
  accuracy    Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  assignedTo InstitutionTemplate[]
  predictions Prediction[]
  exams Exam[]
  
  @@map("templates")
}

// Junction table for Institution-Template assignments
model InstitutionTemplate {
  id            String   @id @default(cuid())
  institutionId String
  templateId    String
  assignedAt    DateTime @default(now())
  status        Status   @default(ACTIVE)
  
  // Relations
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  template    Template    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  @@unique([institutionId, templateId])
  @@map("institution_templates")
}

// Prediction model for student predictions
model Prediction {
  id                  String   @id @default(cuid())
  studentName         String
  studentEmail        String
  rollNumber          String?
  predictedRank       Int?
  predictedPercentile Float?
  bestCaseRank        Int?
  worstCaseRank       Int?
  avgRank             Int?
  bestCasePercentile  Float?
  worstCasePercentile Float?
  avgPercentile       Float?
  accuracy            Float?
  status              String   @default("PENDING")
  predictionType      String?  @default("dataset")
  examName            String?
  examCode            String?
  answers             Json?
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  institutionId String? // Made optional for public access
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  
  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  examId String?
  exam   Exam? @relation(fields: [examId], references: [id], onDelete: SetNull)
  
  @@map("predictions")
}

// Dataset model for training data
model Dataset {
  id          String   @id @default(cuid())
  name        String
  description String?
  fileUrl     String?
  status      Status   @default(ACTIVE)
  recordCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("datasets")
}

// Team Member model for institution team management
model TeamMember {
  id             String   @id @default(cuid())
  name           String
  email          String
  role           String   @default("MEMBER")
  department     String?
  phone          String?
  adminId        String?    
  status         Status   @default(ACTIVE)
  joinedDate     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  
  @@map("team_members")
}

// Exam model for managing exams
model Exam {
  id          String   @id @default(cuid())
  name        String
  examCode    String   @unique
  description String?
  date        DateTime
  duration    Int      // in minutes
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  templateId String
  template   Template @relation(fields: [templateId], references: [id])
  predictions Prediction[]
  conditions ExamCondition[] // New relation to conditions table
  
  @@map("exams")
}

// Exam Conditions model - 9th table for storing conditional prediction rules
model ExamCondition {
  id                   String   @id @default(cuid())
  examId               String
  parameter            String
  operator             String
  value                String
  operator2            String?
  value2               String?
  bestCasePercentile   Float?
  worstCasePercentile  Float?
  bestCaseRank         Int?
  worstCaseRank        Int?
  avgRank              Int?
  avgPercentile        Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  // Relations
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  
  @@map("exam_conditions")
}
model Condition {
  id                     String   @id @default(uuid())

  parameter              String
  operator               String
  value                  Float

  additionalOperator     String?
  additionalValue        Float?

  bestCasePercentile     Float
  worstCasePercentile    Float

  bestCaseRank           Int
  worstCaseRank          Int

  averageRank            Int
  averagePercentile      Float

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}
model InstitutionOnboarding {
  id                String   @id @default(cuid())

  institutionName   String
  contactPerson     String?   // optional but useful

  email             String
  mobile            String

  location          String?

  interestedCourses Json?  // Store as JSON for SQLite compatibility

  message           String?   // optional notes from user

  status            OnboardingStatus @default(NEW)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}


// Enums
enum UserRole {
  STUDENT
  INSTITUTION
  ADMIN
  SUPER_ADMIN
  ANALYST
  MANAGER
}

enum Plan {
  BASIC
  STANDARD
  PREMIUM
  ENTERPRISE
}

// Notification model for super admin alerts
model Notification {
  id          String   @id @default(cuid())
  title       String
  message     String
  type        String   // INSTITUTION_ONBOARDING, TEAM_MEMBER_CREATED, etc.
  read        Boolean  @default(false)
  metadata    Json?    // Additional structured data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("notifications")
}

enum Status {
  ACTIVE
  INACTIVE
  DRAFT
  ARCHIVED
}
enum OnboardingStatus {
  NEW
  CONTACTED
  CONVERTED
  REJECTED
}

enum PredictionType {
  AI
  CONDITIONAL
}